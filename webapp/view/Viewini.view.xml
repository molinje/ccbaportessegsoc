<mvc:View controllerName="ccb.org.aportessegsoc.controller.Viewini"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page id="page" title="{i18n>title}">
     <content>
            <form:SimpleForm id="formAportesSegSoc"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
                emptySpanXL="4" emptySpanL="4" emptySpanM="2" emptySpanS="0"
                columnsXL="1" columnsL="1" columnsM="1">

                <core:Title text="Datos del Empleado" />

                <Label text="Número de Empleado" />
                <Input id="inpPernr" value="{globalData>/userData/d/Pernr}" editable="false" />

                <Label text="Nombre" />
                <Input id="inpNombre" value="{globalData>/userData/d/Nombre}" editable="false" />



                <core:Title text="Parámetros de Aportes de Seguridad Social" />


            </form:SimpleForm>

            <Table id="tblAportesSegSocial"
                items="{globalData>/aportesSegSocial}"
                noDataText="No hay aportes de seguridad social disponibles">
                <columns>
                    <Column>
                        <Text text="Año" />
                    </Column>
                    <Column>
                        <Text text="Periodo" />
                    </Column>
                    <Column>
                        <Text text="Documento" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{globalData>Gjahr}" />
                            <Text text="{globalData>Perio}" />
                            <Link text="{globalData>Documento}" press="onVerDocumento" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Bar>
                <contentRight>
                    <Button id="btnGenerar" text="GENERAR" type="Emphasized" press="onGenerar" />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
